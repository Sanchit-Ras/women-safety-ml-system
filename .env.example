# Copy to .env and fill in. `.env` is gitignored; this file is the documented template.

# --- LLM providers (free tiers) ------------------------------------------------
# Gemini is primary, Groq is the fallback on 429 / 5xx / timeout.
GEMINI_API_KEY=
GROQ_API_KEY=

# Model ids live here, not in code: they churn every few months and a model
# swap should be a config change, not a commit. Check each provider's current
# model list before first use.
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Hard ceiling on real (non-cached) LLM calls in a single run. The client raises
# BudgetExceeded when it is crossed; the orchestrator must let that propagate.
# Cache hits do not count.
MAX_CALLS_PER_RUN=200

# --- Build-time pipeline store ---------------------------------------------------
# SQLite file holding the LLM cache + token ledger, raw rows, records, unit map,
# crosswalk and escalation queue. Gitignored; rebuilt from data/raw and the
# committed verified tables. Relative paths resolve against the repo root.
PIPELINE_DB=data/pipeline.db
