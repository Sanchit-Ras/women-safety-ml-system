# Copy this file to ".env" and fill in the two keys.
# ".env" is ignored by git (your keys never leave your laptop); this template is committed.

# --- 1. Secrets ---------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=

# --- 2. Which models to use ------------------------------------------------------------
# Order of use: Gemini first. Groq only when Gemini is failing or out of quota.
# Both names were checked against each provider's live model list on 2026-09-20.
# Why "Flash Lite": on the free tier the full "Flash" models allow only 20 requests
# per day; "Flash Lite" allows 500 per day.
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b

# --- 3. Free-tier limits (the client keeps itself under these) ---------------------------
# RPM = requests per minute    TPM = tokens per minute
# RPD = requests per day       TPD = tokens per day (leave out if the provider has none)
# Sources: Google AI Studio "Rate limit" page of your project, and
#          https://console.groq.com/docs/rate-limits
GEMINI_RPM=15
GEMINI_TPM=250000
GEMINI_RPD=500
GROQ_RPM=30
GROQ_TPM=8000
GROQ_RPD=1000
GROQ_TPD=200000

# --- 4. Safety wall ---------------------------------------------------------------------
# The most real (non-cached) model calls allowed in ONE run. A bug that loops forever
# hits this wall instead of eating your daily quota. Saved answers do not count.
MAX_CALLS_PER_RUN=150

# --- 5. Where the pipeline database lives ------------------------------------------------
# A SQLite file. Ignored by git; rebuilt from data/raw plus the verified files.
# A relative path is measured from the repo root.
PIPELINE_DB=data/pipeline.db
